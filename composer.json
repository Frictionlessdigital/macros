{
    "name": "frictionlessdigital/macros",
    "description": "Frictionless Solutions | Macros",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "fls",
        "laravel",
        "macros"
    ],
    "require": {
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "friendsofphp/php-cs-fixer": "^3.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.31",
        "mockery/mockery": "^1.5",
        "orchestra/testbench": "^10.0|^11.0|^12.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Fls\\Macros\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fls\\Macros\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "12.x-dev"
        },
        "laravel": {
            "providers": [
                "Fls\\Macros\\MacrosServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyze": "./vendor/bin/phpstan analyze src",
        "test": "./vendor/bin/phpunit --color=always"
    }
}
